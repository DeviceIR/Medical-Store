{
  "name": "medical-instruments",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "db:up": "node scripts/start-embedded-pg.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @medical/api prisma:generate",
    "db:migrate": "pnpm --filter @medical/api prisma:migrate",
    "db:seed": "pnpm --filter @medical/api prisma:seed",
    "db:reset": "pnpm --filter @medical/api prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
