# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/medical_store?schema=public

# API
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
OTP_DEV_CODE=123456
ADMIN_EMAIL=admin@medical.local
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=Admin@12345

# Payments
ZARINPAL_MERCHANT_ID=sandbox
ZARINPAL_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# SMS (leave empty to log OTP in console / show preview code)
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=medical-otp
KAVENEGAR_ORDER_TEMPLATE=medical-order

# Invoice
INVOICE_SELLER_NAME=مدیکال استور
INVOICE_SELLER_NATIONAL_ID=
